{
  "_readme": "Expected shared keys in machine-local config files. These files are rewritten by the tools themselves, so they are never deployed; /ai-global compares these keys and reports drift. Everything not listed here is machine-local by design.",
  "claude_settings": {
    "_file": "~/.claude/settings.json",
    "_note": "共用設定候選；差異只回報，套用需符合授權。插件預設與本機開關由 manifest/skills.json 與 capabilities 管理，不做整塊覆寫。",
    "permissions": {
      "defaultMode": "auto",
      "allow": [
        "Bash(npx vitest run *)",
        "Bash(npm run test)",
        "Bash(npm run test *)",
        "Bash(npm run typecheck)",
        "Bash(npm run typecheck *)",
        "Bash(npm run lint)",
        "Bash(npm run lint *)",
        "Bash(npx tsc --noEmit)",
        "Bash(npx tsc --noEmit *)",
        "Bash(launchctl list *)",
        "mcp__Claude_Browser__read_page",
        "mcp__Claude_Browser__get_page_text",
        "mcp__Claude_Browser__find",
        "mcp__Claude_Browser__read_console_messages",
        "mcp__Claude_Browser__read_network_requests",
        "mcp__Claude_Browser__preview_logs"
      ],
      "deny": [
        "Bash(rm *)",
        "Bash(rmdir *)",
        "Bash(sudo rm *)"
      ],
      "ask": [
        "Bash(git push --force*)",
        "Bash(git push -f*)",
        "Bash(git push origin --delete*)"
      ]
    },
    "statusLine": {
      "type": "command",
      "command": "bash ~/.claude/statusline.sh"
    },
    "extraKnownMarketplaces": {
      "ui-ux-pro-max-skill": {
        "source": {
          "source": "github",
          "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
        }
      },
      "gsap-skills": {
        "source": {
          "source": "github",
          "repo": "greensock/gsap-skills"
        }
      }
    },
    "hooks": {
      "_note": "建議接法。align 會把「腳本在 repo 但沒掛」的列成 hookmissing 衝突（預設不掛，選 wire 才掛）、「掛了但腳本不存在」或「只該在別的平台掛卻在本機掛著」的列成 hook 衝突（預設保留，選 unwire 才移除）；不自動改 settings.json。platforms 省略＝所有平台；值用 deploy.py 的 platform 名稱（macOS／Windows）。",
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "bash ~/.claude/hooks/guard-delete.sh"
            }
          ]
        }
      ],
      "SessionStart": [
        {
          "matcher": "*",
          "hooks": [
            {
              "type": "command",
              "command": "bash ~/.claude/hooks/ai-global-check.sh",
              "timeout": 20
            }
          ]
        }
      ],
      "SessionEnd": [
        {
          "platforms": [
            "macOS"
          ],
          "hooks": [
            {
              "type": "command",
              "command": "bash ~/.claude/hooks/cleanup-orphans.sh --scope session"
            }
          ]
        }
      ]
    }
  },
  "codex_config": {
    "_file": "~/.codex/config.toml",
    "_note": "model / model_reasoning_effort are machine-local by decision (2026-09-07); only personality is shared",
    "personality": "pragmatic"
  }
}
