{
  "_readme": "Expected shared keys in machine-local config files. These files are rewritten by the tools themselves, so they are never deployed; /ai-global compares these keys and reports drift. Everything not listed here is machine-local by design.",
  "claude_settings": {
    "_file": "~/.claude/settings.json",
    "_note": "blocks below are authoritative shared config: ai-global compares deep-equal per block and applies the manifest version after user confirms",
    "permissions": {
      "defaultMode": "auto",
      "allow": [
        "Bash(npx vitest run *)",
        "Bash(npm run test)",
        "Bash(npm run test *)",
        "Bash(npm run typecheck)",
        "Bash(npm run typecheck *)",
        "Bash(npm run lint)",
        "Bash(npm run lint *)",
        "Bash(npx tsc --noEmit)",
        "Bash(npx tsc --noEmit *)",
        "Bash(launchctl list *)",
        "mcp__Claude_Browser__read_page",
        "mcp__Claude_Browser__get_page_text",
        "mcp__Claude_Browser__find",
        "mcp__Claude_Browser__read_console_messages",
        "mcp__Claude_Browser__read_network_requests",
        "mcp__Claude_Browser__preview_logs"
      ],
      "deny": [
        "Bash(rm *)",
        "Bash(rmdir *)",
        "Bash(sudo rm *)"
      ],
      "ask": [
        "Bash(git push --force*)",
        "Bash(git push -f*)",
        "Bash(git push origin --delete*)"
      ]
    },
    "statusLine": {
      "type": "command",
      "command": "bash ~/.claude/statusline.sh"
    },
    "enabledPlugins": {
      "ui-ux-pro-max@ui-ux-pro-max-skill": true,
      "gsap-skills@gsap-skills": true
    },
    "extraKnownMarketplaces": {
      "ui-ux-pro-max-skill": { "source": { "source": "github", "repo": "nextlevelbuilder/ui-ux-pro-max-skill" } },
      "gsap-skills": { "source": { "source": "github", "repo": "greensock/gsap-skills" } }
    }
  },
  "codex_config": {
    "_file": "~/.codex/config.toml",
    "_note": "model / model_reasoning_effort are machine-local by decision (2026-09-07); only personality is shared",
    "personality": "pragmatic"
  }
}
